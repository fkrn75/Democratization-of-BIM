{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoBIM-S7",
  "version": "0.0.1",
  "identifier": "org.dobim.s7spike",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "DoBIM S7 셸", "width": 800, "height": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/dobim", "binaries/dobim-mcp"],
    "resources": { "resources/": "" },
    "license": "MPL-2.0",
    "copyright": "Democratization of BIM contributors",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
