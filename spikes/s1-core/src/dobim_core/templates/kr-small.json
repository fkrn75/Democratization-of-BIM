{
 "format": "dobim.template/1",
 "name": "kr-small",
 "title": "소형 건물(지상 2층) 시작 템플릿",
 "note": "레벨 3개, 평면·반사 천장 평면·입면 뷰, 뷰 템플릿 2개, 시트 4장, 키노트 표. $ 로 시작하는 값은 프로젝트마다 다른 id 로 바뀐다",
 "commands": [
  {"command": "level.create", "args": {"id": "$L1", "name": "1F", "elevation": 0}},
  {"command": "level.create", "args": {"id": "$L2", "name": "2F", "elevation": 3300}},
  {"command": "level.create", "args": {"id": "$LR", "name": "RF", "elevation": 6600}},
  {"command": "view.template.create", "args": {"id": "$T_PLAN", "name": "평면 1:100", "scale": 100}},
  {"command": "view.template.create", "args": {"id": "$T_ELEV", "name": "입면 1:100", "scale": 100}},
  {"command": "view.create", "args": {"id": "$V1", "name": "1F 평면", "type": "plan", "level": "$L1", "cut_height": 1200}},
  {"command": "view.create", "args": {"id": "$V2", "name": "2F 평면", "type": "plan", "level": "$L2", "cut_height": 1200}},
  {"command": "view.create", "args": {"id": "$VR", "name": "지붕 평면", "type": "plan", "level": "$LR", "cut_height": 1200}},
  {"command": "view.rcp", "args": {"id": "$VC1", "name": "1F 반사 천장 평면", "level": "$L1"}},
  {"command": "view.create", "args": {"id": "$VS", "name": "남측 입면", "type": "elevation", "dir": "S"}},
  {"command": "view.create", "args": {"id": "$VN", "name": "북측 입면", "type": "elevation", "dir": "N"}},
  {"command": "view.template.apply", "args": {"view": "$V1", "template": "$T_PLAN"}},
  {"command": "view.template.apply", "args": {"view": "$V2", "template": "$T_PLAN"}},
  {"command": "view.template.apply", "args": {"view": "$VR", "template": "$T_PLAN"}},
  {"command": "view.template.apply", "args": {"view": "$VS", "template": "$T_ELEV"}},
  {"command": "view.template.apply", "args": {"view": "$VN", "template": "$T_ELEV"}},
  {"command": "sheet.define", "args": {"id": "$S101", "name": "A-101 1층 평면도", "views": ["$V1"], "paper": "A3", "sheet_number": "A-101", "sheet_name": "1층 평면도"}},
  {"command": "sheet.define", "args": {"id": "$S102", "name": "A-102 2층 평면도", "views": ["$V2"], "paper": "A3", "sheet_number": "A-102", "sheet_name": "2층 평면도"}},
  {"command": "sheet.define", "args": {"id": "$S103", "name": "A-103 지붕 평면도", "views": ["$VR"], "paper": "A3", "sheet_number": "A-103", "sheet_name": "지붕 평면도"}},
  {"command": "sheet.define", "args": {"id": "$S201", "name": "A-201 입면도", "views": ["$VS", "$VN"], "paper": "A3", "sheet_number": "A-201", "sheet_name": "입면도"}},
  {"command": "keynote.set", "args": {"key": "03.30.00", "text": "현장타설 콘크리트"}},
  {"command": "keynote.set", "args": {"key": "04.20.00", "text": "조적(벽돌)"}},
  {"command": "keynote.set", "args": {"key": "07.21.00", "text": "단열재"}},
  {"command": "keynote.set", "args": {"key": "08.11.00", "text": "금속 문"}},
  {"command": "keynote.set", "args": {"key": "09.21.00", "text": "석고보드"}},
  {"command": "keynote.set", "args": {"key": "09.91.00", "text": "도장"}}
 ]
}
