      "profile": {
        "shape": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "z0",
          "z0 + stool_t"
        ]
      },
      "range": [
        "fy1",
        "st_y1"
      ]
    },
    {
      "id": "casing_l",
      "op": "extrude",
      "plane": "xz",
      "when": "casing_w > 0",
      "profile": {
        "shape": "rect",
        "u": [
          "left - casing_w",
          "left"
        ],
        "v": [
          "z0",
          "z1"
        ]
      },
      "range": [
        "host_thickness/2",
        "host_thickness/2 + casing_t"
      ]
    },
    {
      "id": "casing_r",
      "op": "extrude",
      "plane": "xz",
      "when": "casing_w > 0",
      "profile": {
        "shape": "rect",
        "u": [
          "right",
          "right + casing_w"
        ],
        "v": [
          "z0",
          "z1"
        ]
      },
      "range": [
        "host_thickness/2",
        "host_thickness/2 + casing_t"
      ]
    },
    {
      "id": "casing_h",
      "op": "extrude",
      "plane": "xz",
      "when": "casing_w > 0",
      "profile": {
        "shape": "rect",
        "u": [
          "left - casing_w",
          "right + casing_w"
        ],
        "v": [
          "z1",
          "z1 + casing_w"
        ]
      },
      "range": [
        "host_thickness/2",
        "host_thickness/2 + casing_t"
      ]
    }
  ],
  "plan_symbol": {
    "default": [
      {
        "type": "rect",
        "u": [
          "left",
          "left + frame_w"
        ],
        "v": [
          "fy0",
          "fy1"
        ],
        "style": "cut"
      },
      {
        "type": "rect",
        "u": [
          "right - frame_w",
          "right"
        ],
        "v": [
          "fy0",
          "fy1"
        ],
        "style": "cut"
      },
      {
        "type": "line",
        "from": [
          "left + frame_w",
          "fy0"
        ],
        "to": [
          "right - frame_w",
          "fy0"
        ]
      },
      {
        "type": "line",
        "from": [
          "left + frame_w",
          "fy1"
        ],
        "to": [
          "right - frame_w",
          "fy1"
        ]
      },
      {
        "type": "line",
        "from": [
          "left + frame_w",
          "gy"
        ],
        "to": [
          "right - frame_w",
          "gy"
        ],
        "when": "not sl"
      },
      {
        "type": "line",
        "from": [
          "hinge_x",
          "gy"
        ],
        "to": [
          "hinge_x",
          "gy + open_sign*leaf_w"
        ],
        "when": "casement"
      },
      {
        "type": "arc",
        "center": [
          "hinge_x",
          "gy"
        ],
        "radius": "leaf_w",
        "start": "arc0",
        "end": "arc0 + 90",
        "when": "casement"
      },
      {
        "type": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "fy1",
          "st_y1"
        ],
        "when": "stool_on"
      },
      {
        "type": "line",
        "when": "sl",
        "from": [
          "left + frame_w",
          "gy - sl_d/2"
        ],
        "to": [
          "left + frame_w + sl_w",
          "gy - sl_d/2"
        ]
      },
      {
        "type": "line",
        "when": "sl",
        "from": [
          "right - frame_w - sl_w",
          "gy + sl_d/2"
        ],
        "to": [
          "right - frame_w",
          "gy + sl_d/2"
        ]
      },
      {
        "type": "line",
        "when": "operation == 'project_out' and mullions == 0 and n_tr == 0",
        "from": [
          "left + frame_w",
          "fy0"
        ],
        "to": [
          "right - frame_w",
          "fy0 - 60"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and (e1 == 'project_out' or (n_tr >= 1 and e12 == 'project_out') or (n_tr >= 2 and e13 == 'project_out'))",
        "from": [
          "b1a",
          "fy0"
        ],
        "to": [
          "b1b",
          "fy0 - 60"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and mullions >= 1 and (e2 == 'project_out' or (n_tr >= 1 and e22 == 'project_out') or (n_tr >= 2 and e23 == 'project_out'))",
        "from": [
          "b2a",
          "fy0"
        ],
        "to": [
          "b2b",
          "fy0 - 60"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and mullions >= 2 and (e3 == 'project_out' or (n_tr >= 1 and e32 == 'project_out') or (n_tr >= 2 and e33 == 'project_out'))",
        "from": [
          "b3a",
          "fy0"
        ],
        "to": [
          "b3b",
          "fy0 - 60"
        ]
      },
      {
        "type": "line",
        "when": "operation == 'project_left' and mullions == 0 and n_tr == 0",
        "from": [
          "left + frame_w",
          "fy0"
        ],
        "to": [
          "right - frame_w",
          "fy0 - leaf_w/4"
        ]
      },
      {
        "type": "line",
        "when": "operation == 'project_right' and mullions == 0 and n_tr == 0",
        "from": [
          "right - frame_w",
          "fy0"
        ],
        "to": [
          "left + frame_w",
          "fy0 - leaf_w/4"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and (e1 == 'project_left' or (n_tr >= 1 and e12 == 'project_left') or (n_tr >= 2 and e13 == 'project_left'))",
        "from": [
          "b1a",
          "fy0"
        ],
        "to": [
          "b1b",
          "fy0 - (b1b - b1a)/4"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and (e1 == 'project_right' or (n_tr >= 1 and e12 == 'project_right') or (n_tr >= 2 and e13 == 'project_right'))",
        "from": [
          "b1b",
          "fy0"
        ],
        "to": [
          "b1a",
          "fy0 - (b1b - b1a)/4"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and mullions >= 1 and (e2 == 'project_left' or (n_tr >= 1 and e22 == 'project_left') or (n_tr >= 2 and e23 == 'project_left'))",
        "from": [
          "b2a",
          "fy0"
        ],
        "to": [
          "b2b",
          "fy0 - (b2b - b2a)/4"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and mullions >= 1 and (e2 == 'project_right' or (n_tr >= 1 and e22 == 'project_right') or (n_tr >= 2 and e23 == 'project_right'))",
        "from": [
          "b2b",
          "fy0"
        ],
        "to": [
          "b2a",
          "fy0 - (b2b - b2a)/4"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and mullions >= 2 and (e3 == 'project_left' or (n_tr >= 1 and e32 == 'project_left') or (n_tr >= 2 and e33 == 'project_left'))",
        "from": [
          "b3a",
          "fy0"
        ],
        "to": [
          "b3b",
          "fy0 - (b3b - b3a)/4"
        ]
      },
      {
        "type": "line",
        "when": "bay_mixed and mullions >= 2 and (e3 == 'project_right' or (n_tr >= 1 and e32 == 'project_right') or (n_tr >= 2 and e33 == 'project_right'))",
        "from": [
          "b3b",
          "fy0"
        ],
        "to": [
          "b3a",
          "fy0 - (b3b - b3a)/4"
        ]
      }
    ],
    "1:200": [
      {
        "type": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "fy0",
          "fy1"
        ],
        "style": "cut"
      }
    ]
  },
  "psets": {
    "Pset_WindowCommon": {
      "on": "type",
      "props": {
        "IsExternal": {
          "expr": "is_external"
        },
        "ThermalTransmittance": {
          "expr": "u_value"
        },
        "GlazingAreaFraction": {
          "expr": "round(glass_ratio, 3)"
        }
      }
    },
    "DoBIM_WindowFrame": {
      "on": "type",
      "props": {
        "Operation": {
          "expr": "operation"
        },
        "FrameWidth": {
          "expr": "frame_w"
        },
        "FrameDepth": {
          "expr": "frame_d"
        },
        "TransomCount": {
          "expr": "n_tr"
        }
      }
    },
    "DoBIM_WindowParams": {
      "on": "instance",
      "props": {
        "SillHeight": {
          "expr": "sill"
        },
        "Inset": {
          "expr": "ie"
        },
        "Hinge": {
          "expr": "hinge"
        }
      }
    }
  }
