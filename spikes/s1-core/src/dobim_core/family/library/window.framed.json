{
  "schema": "dobim.family/1",
  "id": "window.framed",
  "version": 3,
  "name": "창틀 창(리빌 표현)",
  "description": "벽에 호스팅되는 창. 깊이 있는 창틀·유리·(열리는 창이면 문짝 틀)·선택 창대/문선. 열림 방식: 고정·여닫이(안/밖)·프로젝트(위 경첩 밖 젖힘)·미닫이(두 짝). 틀의 벽 안 위치(inset = 기준면에서 틀 바깥면까지)로 리빌이 보인다. 기준면 = 호스트 지역 -v 면, 180 뒤집으면 +v 면. 25단계: 멀리언으로 나눈 칸마다 열림 방식(bay1~bay3 = same/fixed/project_out)을 줄 수 있다(고정 + 프로젝트 혼합).",
  "ifc": {
    "class": "IfcWindow",
    "type_class": "IfcWindowType",
    "predefined": "WINDOW",
    "type_attrs": {
      "PartitioningType": {
        "expr": "'DOUBLE_PANEL_VERTICAL' if sl else ('SINGLE_PANEL' if mullions == 0 else ('DOUBLE_PANEL_VERTICAL' if mullions == 1 else 'TRIPLE_PANEL_VERTICAL'))"
      },
      "ParameterTakesPrecedence": false
    },
    "attrs": {
      "OverallWidth": {
        "expr": "width"
      },
      "OverallHeight": {
        "expr": "height"
      }
    },
    "panels": [
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e1 == 'fixed' else ('TOPHUNG' if e1 == 'project_out' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))"
        },
        "position": {
          "expr": "'LEFT' if sl or mullions > 0 else 'MIDDLE'"
        }
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e2 == 'fixed' else ('TOPHUNG' if e2 == 'project_out' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))"
        },
        "position": {
          "expr": "'RIGHT' if sl or mullions == 1 else 'MIDDLE'"
        },
        "when": "sl or mullions > 0"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e3 == 'fixed' else ('TOPHUNG' if e3 == 'project_out' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))"
        },
        "position": "RIGHT",
        "when": "mullions == 2"
      }
    ]
  },
  "host": {
    "kinds": [
      "wall"
    ],
    "cut": {
      "x": [
        "left",
        "right"
      ],
      "z": [
        "z0",
        "z1"
      ]
    }
  },
  "params": {
    "width": {
      "kind": "type",
      "default": 1200,
      "unit": "mm",
      "description": "개구부 폭(틀 바깥)",
      "min": 400,
      "max": 6000
    },
    "height": {
      "kind": "type",
      "default": 1200,
      "unit": "mm",
      "description": "개구부 높이(틀 바깥)",
      "min": 400,
      "max": 6000
    },
    "operation": {
      "kind": "type",
      "default": "fixed",
      "type": "enum",
      "values": [
        "fixed",
        "casement_in",
        "casement_out",
        "project_out",
        "sliding"
      ],
      "description": "fixed=고정창, casement_in/out=여닫이(안/밖), project_out=프로젝트창(위 경첩, 밖으로 젖힘), sliding=미닫이창(두 짝)"
    },
    "frame_w": {
      "kind": "type",
      "default": 60,
      "unit": "mm",
      "description": "창틀 단면 폭(정면에서 본 틀 두께)",
      "min": 30,
      "max": 120
    },
    "frame_d": {
      "kind": "type",
      "default": 70,
      "unit": "mm",
      "description": "창틀 깊이(벽 두께 방향). 벽보다 깊으면 벽 두께로 줄어든다",
      "min": 50,
      "max": 200
    },
    "glass_t": {
      "kind": "type",
      "default": 24,
      "unit": "mm",
      "description": "유리 두께",
      "min": 6,
      "max": 30
    },
    "mullions": {
      "kind": "type",
      "default": 0,
      "type": "int",
      "unit": "none",
      "description": "세로 멀리언 개수(고정창만)",
      "min": 0,
      "max": 2
    },
    "bay1": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out"
      ],
      "description": "1번째 칸(지역 -x 부터)의 열림 방식. same 이면 operation 을 따른다. 멀리언으로 칸을 나눈 fixed/project_out 창에서만 쓰고, 그 밖(칸이 없거나 여닫이·미닫이)에서는 무시한다"
    },
    "bay2": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out"
      ],
      "description": "2번째 칸(지역 -x 부터)의 열림 방식. same 이면 operation 을 따른다. 멀리언으로 칸을 나눈 fixed/project_out 창에서만 쓰고, 그 밖(칸이 없거나 여닫이·미닫이)에서는 무시한다"
    },
    "bay3": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out"
      ],
      "description": "3번째 칸(지역 -x 부터)의 열림 방식. same 이면 operation 을 따른다. 멀리언으로 칸을 나눈 fixed/project_out 창에서만 쓰고, 그 밖(칸이 없거나 여닫이·미닫이)에서는 무시한다"
    },
    "stool_t": {
      "kind": "type",
      "default": 20,
      "unit": "mm",
      "description": "창대(실내 쪽 하부 판) 두께, 0 이면 없음",
      "min": 0,
      "max": 60
    },
    "stool_proj": {
      "kind": "type",
      "default": 25,
      "unit": "mm",
      "description": "창대가 벽 안쪽 면 밖으로 내민 길이",
      "min": 0,
      "max": 100
    },
    "casing_w": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "description": "문선(실내 쪽 개구부 둘레 띠) 폭, 0 이면 없음",
      "min": 0,
      "max": 150
    },
    "casing_t": {
      "kind": "type",
      "default": 12,
      "unit": "mm",
      "description": "문선 두께(벽 안쪽 면에서 튀어나온 길이)",
      "min": 5,
      "max": 40
    },
    "u_value": {
      "kind": "type",
      "default": 1.6,
      "unit": "none",
      "description": "열관류율 W/m2K",
      "min": 0.5,
      "max": 5.0
    },
    "is_external": {
      "kind": "type",
      "default": true,
      "type": "bool"
    },
    "sill": {
      "kind": "instance",
      "default": 900,
      "unit": "mm",
      "description": "바닥에서 창 하단까지",
      "min": 0,
      "max": 12000
    },
    "inset": {
      "kind": "instance",
      "default": 100,
      "unit": "mm",
      "description": "기준면(호스트 지역 -v 면, 뒤집으면 +v 면)에서 창틀 바깥면까지 거리(리빌 깊이). 0 이면 기준면에 맞춤. 벽이 얇으면 틀이 벽 안에 들어가는 최대값으로 줄어든다",
      "min": 0,
      "max": 600
    },
    "hinge": {
      "kind": "instance",
      "default": "L",
      "type": "enum",
      "values": [
        "L",
        "R"
      ],
      "description": "여닫이일 때 경첩 쪽(L = 지역 -x 쪽)"
    }
  },
  "derived": {
    "z0": "sill",
    "z1": "sill + height",
    "fd": "min(frame_d, host_thickness)",
    "ie": "max(0, min(inset, host_thickness - fd))",
    "fy0": "-host_thickness/2 + ie",
    "fy1": "fy0 + fd",
    "gy": "fy0 + fd/2",
    "sash_w": "frame_w*0.8",
    "sash_d": "fd - 10",
    "gm": "frame_w if operation == 'fixed' else frame_w + sash_w",
    "inner_w": "width - 2*gm",
    "inner_h": "height - 2*gm",
    "leaf_w": "width - 2*frame_w",
    "hinge_x": "(-width/2 + frame_w) if hinge == 'L' else (width/2 - frame_w)",
    "open_sign": "1 if operation == 'casement_in' else -1",
    "arc0": "(0 if hinge == 'L' else 90) if operation == 'casement_in' else (270 if hinge == 'L' else 180)",
    "st_y1": "host_thickness/2 + stool_proj",
    "stool_on": "stool_t > 0 and st_y1 > fy1",
    "glass_ratio": "inner_w*inner_h/(width*height)",
    "sl": "operation == 'sliding'",
    "casement": "operation == 'casement_in' or operation == 'casement_out'",
    "sl_d": "(fd - 10)/2",
    "sl_w": "(width - 2*frame_w + sash_w)/2",
    "e1": "bay1 if bay1 != 'same' and mullions > 0 and (operation == 'fixed' or operation == 'project_out') else operation",
    "e2": "bay2 if bay2 != 'same' and mullions > 0 and (operation == 'fixed' or operation == 'project_out') else operation",
    "e3": "bay3 if bay3 != 'same' and mullions >= 2 and (operation == 'fixed' or operation == 'project_out') else operation",
    "bay_mixed": "mullions > 0 and (e1 == 'project_out' or e2 == 'project_out' or (mullions >= 2 and e3 == 'project_out'))",
    "b1a": "left + frame_w",
    "b1b": "left + frame_w + (width - 2*frame_w)/(mullions + 1) - frame_w/4",
    "b2a": "left + frame_w + (width - 2*frame_w)/(mullions + 1) + frame_w/4",
    "b2b": "(left + frame_w + 2*(width - 2*frame_w)/(mullions + 1) - frame_w/4) if mullions >= 2 else (right - frame_w)",
    "b3a": "left + frame_w + 2*(width - 2*frame_w)/(mullions + 1) + frame_w/4",
    "b3b": "right - frame_w",
    "p1": "bay_mixed and e1 == 'project_out'",
    "p2": "bay_mixed and e2 == 'project_out'",
    "p3": "bay_mixed and mullions >= 2 and e3 == 'project_out'",
    "g1": "sash_w if p1 else 0",
    "g2": "sash_w if p2 else 0",
    "g3": "sash_w if p3 else 0"
  },
  "refs": {
    "left": {
      "axis": "x",
      "at": "-width/2"
    },
    "right": {
      "axis": "x",
      "at": "width/2"
    }
  },
  "constraints": [
    {
      "expr": "inner_w >= 100 and inner_h >= 100",
      "message": "유리 개구가 100mm 미만이다(frame_w 를 줄이거나 width/height 를 키우세요)"
    },
    {
      "expr": "glass_t <= fd - 10",
      "message": "유리가 틀 깊이보다 10mm 이상 얇아야 한다(frame_d 를 키우거나 glass_t 를 줄이세요)"
    },
    {
      "expr": "operation == 'fixed' or operation == 'project_out' or mullions == 0",
      "message": "멀리언은 고정창·프로젝트창에만 둘 수 있다(여닫이·미닫이는 mullions 를 0 으로)"
    },
    {
      "expr": "operation != 'sliding' or glass_t <= sl_d - 4",
      "message": "미닫이창은 유리가 문짝 두께(틀 깊이의 절반 안팎)보다 4mm 이상 얇아야 한다(frame_d 를 키우거나 glass_t 를 줄이세요)"
    },
    {
      "expr": "operation != 'sliding' or sl_w - 2*sash_w >= 100",
      "message": "미닫이 문짝의 유리 폭이 100mm 미만이다(width 를 키우세요)"
    },
    {
      "expr": "not bay_mixed or (b1b - b1a - 2*sash_w >= 100 and b2b - b2a - 2*sash_w >= 100)",
      "message": "프로젝트 칸의 유리 폭이 100mm 미만이다(width 를 키우거나 멀리언을 줄이세요)"
    }
  ],
  "solids": [
    {
      "id": "frame",
      "op": "extrude",
      "plane": "xz",
      "profile": {
        "shape": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "z0",
          "z1"
        ]
      },
      "range": [
        "fy0",
        "fy1"
      ]
    },
    {
      "id": "frame_hole",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "frame"
      ],
      "profile": {
        "shape": "rect",
        "u": [
          "left + frame_w",
          "right - frame_w"
        ],
        "v": [
          "z0 + frame_w",
          "z1 - frame_w"
        ]
      },
      "range": [
        "fy0 - fd",
        "fy1 + fd"
      ]
    },
    {
      "id": "sash",
      "op": "extrude",
      "plane": "xz",
      "when": "operation != 'fixed' and not sl and mullions == 0",
      "profile": {
        "shape": "rect",
        "u": [
          "left + frame_w",
          "right - frame_w"
        ],
        "v": [
          "z0 + frame_w",
          "z1 - frame_w"
        ]
      },
      "range": [
        "gy - sash_d/2",
        "gy + sash_d/2"
      ]
    },
    {
      "id": "sash_hole",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "sash"
      ],
      "when": "operation != 'fixed' and not sl and mullions == 0",
      "profile": {
        "shape": "rect",
        "u": [
          "left + gm",
          "right - gm"
        ],
        "v": [
          "z0 + gm",
          "z1 - gm"
        ]
      },
      "range": [
        "gy - sash_d",
        "gy + sash_d"
      ]
    },
    {
      "id": "glass",
      "op": "extrude",
      "plane": "xz",
      "profile": {
        "shape": "rect",
        "u": [
          "left + gm",
          "right - gm"
        ],
        "v": [
          "z0 + gm",
          "z1 - gm"
        ]
      },
      "range": [
        "gy - glass_t/2",
        "gy + glass_t/2"
      ],
      "when": "not sl and not bay_mixed"
    },
    {
      "id": "bay_sash1",
      "op": "extrude",
      "plane": "xz",
      "when": "p1",
      "profile": {
        "shape": "rect",
        "u": [
          "b1a",
          "b1b"
        ],
        "v": [
          "z0 + frame_w",
          "z1 - frame_w"
        ]
      },
      "range": [
        "gy - sash_d/2",
        "gy + sash_d/2"
      ]
    },
    {
      "id": "bay_sash_hole1",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "bay_sash1"
      ],
      "when": "p1",
      "profile": {
        "shape": "rect",
        "u": [
          "b1a + sash_w",
          "b1b - sash_w"
        ],
        "v": [
          "z0 + frame_w + sash_w",
          "z1 - frame_w - sash_w"
        ]
      },
      "range": [
        "gy - sash_d",
        "gy + sash_d"
      ]
    },
    {
      "id": "bay_glass1",
      "op": "extrude",
      "plane": "xz",
      "when": "bay_mixed",
      "profile": {
        "shape": "rect",
        "u": [
          "b1a + g1",
          "b1b - g1"
        ],
        "v": [
          "z0 + frame_w + g1",
          "z1 - frame_w - g1"
        ]
      },
      "range": [
        "gy - glass_t/2",
        "gy + glass_t/2"
      ]
    },
    {
      "id": "bay_sash2",
      "op": "extrude",
      "plane": "xz",
      "when": "p2",
      "profile": {
        "shape": "rect",
        "u": [
          "b2a",
          "b2b"
        ],
        "v": [
          "z0 + frame_w",
          "z1 - frame_w"
        ]
      },
      "range": [
        "gy - sash_d/2",
        "gy + sash_d/2"
      ]
    },
    {
      "id": "bay_sash_hole2",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "bay_sash2"
      ],
      "when": "p2",
      "profile": {
        "shape": "rect",
        "u": [
          "b2a + sash_w",
          "b2b - sash_w"
        ],
        "v": [
          "z0 + frame_w + sash_w",
          "z1 - frame_w - sash_w"
        ]
      },
      "range": [
        "gy - sash_d",
        "gy + sash_d"
      ]
    },
    {
      "id": "bay_glass2",
      "op": "extrude",
      "plane": "xz",
      "when": "bay_mixed",
      "profile": {
        "shape": "rect",
        "u": [
          "b2a + g2",
          "b2b - g2"
        ],
        "v": [
          "z0 + frame_w + g2",
          "z1 - frame_w - g2"
        ]
      },
      "range": [
        "gy - glass_t/2",
        "gy + glass_t/2"
      ]
    },
    {
      "id": "bay_sash3",
      "op": "extrude",
      "plane": "xz",
      "when": "p3",
      "profile": {
        "shape": "rect",
        "u": [
          "b3a",
          "b3b"
        ],
        "v": [
          "z0 + frame_w",
          "z1 - frame_w"
        ]
      },
      "range": [
        "gy - sash_d/2",
        "gy + sash_d/2"
      ]
    },
    {
      "id": "bay_sash_hole3",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "bay_sash3"
      ],
      "when": "p3",
      "profile": {
        "shape": "rect",
        "u": [
          "b3a + sash_w",
          "b3b - sash_w"
        ],
        "v": [
          "z0 + frame_w + sash_w",
          "z1 - frame_w - sash_w"
        ]
      },
      "range": [
        "gy - sash_d",
        "gy + sash_d"
      ]
    },
    {
      "id": "bay_glass3",
      "op": "extrude",
      "plane": "xz",
      "when": "bay_mixed and mullions >= 2",
      "profile": {
        "shape": "rect",
        "u": [
          "b3a + g3",
          "b3b - g3"
        ],
        "v": [
          "z0 + frame_w + g3",
          "z1 - frame_w - g3"
        ]
      },
      "range": [
        "gy - glass_t/2",
        "gy + glass_t/2"
      ]
    },
    {
      "id": "sl_sash",
      "op": "extrude",
      "plane": "xz",
      "when": "sl",
      "repeat": {
        "var": "i",
        "count": 2
      },
      "profile": {
        "shape": "rect",
        "u": [
          "left + frame_w + i*(width - 2*frame_w - sl_w)",
          "left + frame_w + i*(width - 2*frame_w - sl_w) + sl_w"
        ],
        "v": [
          "z0 + frame_w",
          "z1 - frame_w"
        ]
      },
      "range": [
        "gy - sl_d + i*sl_d",
        "gy + i*sl_d"
      ]
    },
    {
      "id": "sl_hole",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "sl_sash"
      ],
      "when": "sl",
      "repeat": {
        "var": "i",
        "count": 2
      },
      "profile": {
        "shape": "rect",
        "u": [
          "left + frame_w + i*(width - 2*frame_w - sl_w) + sash_w",
          "left + frame_w + i*(width - 2*frame_w - sl_w) + sl_w - sash_w"
        ],
        "v": [
          "z0 + gm",
          "z1 - gm"
        ]
      },
      "range": [
        "gy - 2*sl_d",
        "gy + 2*sl_d"
      ]
    },
    {
      "id": "sl_glass",
      "op": "extrude",
      "plane": "xz",
      "when": "sl",
      "repeat": {
        "var": "i",
        "count": 2
      },
      "profile": {
        "shape": "rect",
        "u": [
          "left + frame_w + i*(width - 2*frame_w - sl_w) + sash_w",
          "left + frame_w + i*(width - 2*frame_w - sl_w) + sl_w - sash_w"
        ],
        "v": [
          "z0 + gm",
          "z1 - gm"
        ]
      },
      "range": [
        "gy - sl_d/2 + i*sl_d - glass_t/2",
        "gy - sl_d/2 + i*sl_d + glass_t/2"
      ]
    },
    {
      "id": "mullion",
      "op": "extrude",
      "plane": "xz",
      "repeat": {
        "var": "i",
        "count": "mullions"
      },
      "profile": {
        "shape": "rect",
        "u": [
          "left + frame_w + (i + 1)*(width - 2*frame_w)/(mullions + 1) - frame_w/4",
          "left + frame_w + (i + 1)*(width - 2*frame_w)/(mullions + 1) + frame_w/4"
        ],
        "v": [
          "z0 + frame_w",
          "z1 - frame_w"
        ]
      },
      "range": [
        "fy0",
        "fy1"
      ]
    },
    {
      "id": "stool",
      "op": "extrude",
      "plane": "xz",
      "when": "stool_on",
      "profile": {
        "shape": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "z0",
          "z0 + stool_t"
        ]
      },
      "range": [
        "fy1",
        "st_y1"
      ]
    },
    {
      "id": "casing_l",
      "op": "extrude",
      "plane": "xz",
      "when": "casing_w > 0",
      "profile": {
        "shape": "rect",
        "u": [
          "left - casing_w",
          "left"
        ],
        "v": [
          "z0",
          "z1"
        ]
      },
      "range": [
        "host_thickness/2",
        "host_thickness/2 + casing_t"
      ]
    },
    {
      "id": "casing_r",
      "op": "extrude",
      "plane": "xz",
      "when": "casing_w > 0",
      "profile": {
        "shape": "rect",
        "u": [
          "right",
          "right + casing_w"
        ],
        "v": [
          "z0",
          "z1"
        ]
      },
      "range": [
        "host_thickness/2",
        "host_thickness/2 + casing_t"
      ]
    },
    {
      "id": "casing_h",
      "op": "extrude",
      "plane": "xz",
      "when": "casing_w > 0",
      "profile": {
        "shape": "rect",
        "u": [
          "left - casing_w",
          "right + casing_w"
        ],
        "v": [
          "z1",
          "z1 + casing_w"
        ]
      },
      "range": [
        "host_thickness/2",
        "host_thickness/2 + casing_t"
      ]
    }
  ],
  "plan_symbol": {
    "default": [
      {
        "type": "rect",
        "u": [
          "left",
          "left + frame_w"
        ],
        "v": [
          "fy0",
          "fy1"
        ],
        "style": "cut"
      },
      {
        "type": "rect",
        "u": [
          "right - frame_w",
          "right"
        ],
        "v": [
          "fy0",
          "fy1"
        ],
        "style": "cut"
      },
      {
        "type": "line",
        "from": [
          "left + frame_w",
          "fy0"
        ],
        "to": [
          "right - frame_w",
          "fy0"
        ]
      },
      {
        "type": "line",
        "from": [
          "left + frame_w",
          "fy1"
        ],
        "to": [
          "right - frame_w",
          "fy1"
        ]
      },
      {
        "type": "line",
        "from": [
          "left + frame_w",
          "gy"
        ],
        "to": [
          "right - frame_w",
          "gy"
        ],
        "when": "not sl"
      },
      {
        "type": "line",
        "from": [
          "hinge_x",
          "gy"
        ],
        "to": [
          "hinge_x",
          "gy + open_sign*leaf_w"
        ],
        "when": "casement"
      },
      {
        "type": "arc",
        "center": [
          "hinge_x",
          "gy"
        ],
        "radius": "leaf_w",
        "start": "arc0",
        "end": "arc0 + 90",
        "when": "casement"
      },
      {
        "type": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "fy1",
          "st_y1"
        ],
        "when": "stool_on"
      },
      {
        "type": "line",
        "when": "sl",
        "from": [
          "left + frame_w",
          "gy - sl_d/2"
        ],
        "to": [
          "left + frame_w + sl_w",
          "gy - sl_d/2"
        ]
      },
      {
        "type": "line",
        "when": "sl",
        "from": [
          "right - frame_w - sl_w",
          "gy + sl_d/2"
        ],
        "to": [
          "right - frame_w",
          "gy + sl_d/2"
        ]
      },
      {
        "type": "line",
        "when": "operation == 'project_out' and mullions == 0",
        "from": [
          "left + frame_w",
          "fy0"
        ],
        "to": [
          "right - frame_w",
          "fy0 - 60"
        ]
      },
      {
        "type": "line",
        "when": "p1",
        "from": [
          "b1a",
          "fy0"
        ],
        "to": [
          "b1b",
          "fy0 - 60"
        ]
      },
      {
        "type": "line",
        "when": "p2",
        "from": [
          "b2a",
          "fy0"
        ],
        "to": [
          "b2b",
          "fy0 - 60"
        ]
      },
      {
        "type": "line",
        "when": "p3",
        "from": [
          "b3a",
          "fy0"
        ],
        "to": [
          "b3b",
          "fy0 - 60"
        ]
      }
    ],
    "1:200": [
      {
        "type": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "fy0",
          "fy1"
        ],
        "style": "cut"
      }
    ]
  },
  "psets": {
    "Pset_WindowCommon": {
      "on": "type",
      "props": {
        "IsExternal": {
          "expr": "is_external"
        },
        "ThermalTransmittance": {
          "expr": "u_value"
        },
        "GlazingAreaFraction": {
          "expr": "round(glass_ratio, 3)"
        }
      }
    },
    "DoBIM_WindowFrame": {
      "on": "type",
      "props": {
        "Operation": {
          "expr": "operation"
        },
        "FrameWidth": {
          "expr": "frame_w"
        },
        "FrameDepth": {
          "expr": "frame_d"
        }
      }
    },
    "DoBIM_WindowParams": {
      "on": "instance",
      "props": {
        "SillHeight": {
          "expr": "sill"
        },
        "Inset": {
          "expr": "ie"
        },
        "Hinge": {
          "expr": "hinge"
        }
      }
    }
  }
}
