{
  "schema": "dobim.family/1",
  "id": "window.framed",
  "version": 4,
  "name": "창틀 창(리빌 표현)",
  "description": "벽에 호스팅되는 창. 창틀·유리·창짝·선택 창대/문선. 열림: 고정·여닫이·프로젝트(위 경첩 project_out, 옆 경첩 project_left/right)·미닫이. inset 으로 리빌이 보인다(기준면 = 지역 -v 면, 180 뒤집으면 +v). 멀리언(칸)·가로대(transom, transom2 = 단)로 나눈 단x칸마다 열림 방식(bay1~3 = 아래 단, bay1_2~3_2 = 2단, bay1_3~3_3 = 3단)을 줄 수 있다.",
  "ifc": {
    "class": "IfcWindow",
    "type_class": "IfcWindowType",
    "predefined": "WINDOW",
    "type_attrs": {
      "PartitioningType": {
        "expr": "'DOUBLE_PANEL_VERTICAL' if sl else (('SINGLE_PANEL' if mullions == 0 else ('DOUBLE_PANEL_VERTICAL' if mullions == 1 else 'TRIPLE_PANEL_VERTICAL')) if n_tr == 0 else ('USERDEFINED' if mullions > 0 else ('DOUBLE_PANEL_HORIZONTAL' if n_tr == 1 else 'TRIPLE_PANEL_HORIZONTAL')))"
      },
      "ParameterTakesPrecedence": false
    },
    "attrs": {
      "OverallWidth": {
        "expr": "width"
      },
      "OverallHeight": {
        "expr": "height"
      }
    },
    "panels": [
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e1 == 'fixed' else ('TOPHUNG' if e1 == 'project_out' else ('SIDEHUNGLEFTHAND' if e1 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e1 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": {
          "expr": "('LEFT' if sl or mullions > 0 else 'MIDDLE') if n_tr == 0 else ('LEFT' if mullions > 0 else 'BOTTOM')"
        }
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e2 == 'fixed' else ('TOPHUNG' if e2 == 'project_out' else ('SIDEHUNGLEFTHAND' if e2 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e2 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": {
          "expr": "'RIGHT' if sl or mullions == 1 else 'MIDDLE'"
        },
        "when": "sl or mullions > 0"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e3 == 'fixed' else ('TOPHUNG' if e3 == 'project_out' else ('SIDEHUNGLEFTHAND' if e3 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e3 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": "RIGHT",
        "when": "mullions == 2"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e12 == 'fixed' else ('TOPHUNG' if e12 == 'project_out' else ('SIDEHUNGLEFTHAND' if e12 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e12 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": {
          "expr": "'LEFT' if mullions > 0 else ('MIDDLE' if n_tr == 2 else 'TOP')"
        },
        "when": "n_tr >= 1"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e22 == 'fixed' else ('TOPHUNG' if e22 == 'project_out' else ('SIDEHUNGLEFTHAND' if e22 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e22 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": {
          "expr": "'RIGHT' if mullions == 1 else 'MIDDLE'"
        },
        "when": "n_tr >= 1 and mullions > 0"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e32 == 'fixed' else ('TOPHUNG' if e32 == 'project_out' else ('SIDEHUNGLEFTHAND' if e32 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e32 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": "RIGHT",
        "when": "n_tr >= 1 and mullions == 2"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e13 == 'fixed' else ('TOPHUNG' if e13 == 'project_out' else ('SIDEHUNGLEFTHAND' if e13 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e13 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": {
          "expr": "'LEFT' if mullions > 0 else 'TOP'"
        },
        "when": "n_tr >= 2"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e23 == 'fixed' else ('TOPHUNG' if e23 == 'project_out' else ('SIDEHUNGLEFTHAND' if e23 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e23 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": {
          "expr": "'RIGHT' if mullions == 1 else 'MIDDLE'"
        },
        "when": "n_tr >= 2 and mullions > 0"
      },
      {
        "operation": {
          "expr": "'FIXEDCASEMENT' if e33 == 'fixed' else ('TOPHUNG' if e33 == 'project_out' else ('SIDEHUNGLEFTHAND' if e33 == 'project_left' else ('SIDEHUNGRIGHTHAND' if e33 == 'project_right' else ('SLIDINGHORIZONTAL' if sl else 'NOTDEFINED'))))"
        },
        "position": "RIGHT",
        "when": "n_tr >= 2 and mullions == 2"
      }
    ]
  },
  "host": {
    "kinds": [
      "wall"
    ],
    "cut": {
      "x": [
        "left",
        "right"
      ],
      "z": [
        "z0",
        "z1"
      ]
    }
  },
  "params": {
    "width": {
      "kind": "type",
      "default": 1200,
      "unit": "mm",
      "description": "개구부 폭(틀 바깥)",
      "min": 400,
      "max": 6000
    },
    "height": {
      "kind": "type",
      "default": 1200,
      "unit": "mm",
      "description": "개구부 높이(틀 바깥)",
      "min": 400,
      "max": 6000
    },
    "operation": {
      "kind": "type",
      "default": "fixed",
      "type": "enum",
      "values": [
        "fixed",
        "casement_in",
        "casement_out",
        "project_out",
        "sliding",
        "project_left",
        "project_right"
      ],
      "description": "fixed=고정창, casement_in/out=여닫이(안/밖), project_out=프로젝트창(위 경첩, 밖으로 젖힘), sliding=미닫이창(두 짝), project_left/project_right=옆 경첩 프로젝트창(밖으로 젖힘, 경첩이 바깥(-v 쪽)에서 볼 때 왼쪽 = 지역 -x / 오른쪽)"
    },
    "frame_w": {
      "kind": "type",
      "default": 60,
      "unit": "mm",
      "description": "창틀 단면 폭(정면에서 본 틀 두께)",
      "min": 30,
      "max": 120
    },
    "frame_d": {
      "kind": "type",
      "default": 70,
      "unit": "mm",
      "description": "창틀 깊이(벽 두께 방향). 벽보다 깊으면 벽 두께로 줄어든다",
      "min": 50,
      "max": 200
    },
    "glass_t": {
      "kind": "type",
      "default": 24,
      "unit": "mm",
      "description": "유리 두께",
      "min": 6,
      "max": 30
    },
    "mullions": {
      "kind": "type",
      "default": 0,
      "type": "int",
      "unit": "none",
      "description": "세로 멀리언 개수(고정창·프로젝트창만)",
      "min": 0,
      "max": 2
    },
    "bay1": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "아래 단 1번째 칸(지역 -x 부터)의 열림 방식. same 이면 operation 을 따른다. 멀리언·가로대로 칸을 나눈 고정창·프로젝트창에서만 쓰고, 그 밖(칸이 없거나 여닫이·미닫이)에서는 무시한다"
    },
    "bay2": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "아래 단 2번째 칸(지역 -x 부터)의 열림 방식. same 이면 operation 을 따른다. 멀리언·가로대로 칸을 나눈 고정창·프로젝트창에서만 쓰고, 그 밖(칸이 없거나 여닫이·미닫이)에서는 무시한다"
    },
    "bay3": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "아래 단 3번째 칸(지역 -x 부터)의 열림 방식. same 이면 operation 을 따른다. 멀리언·가로대로 칸을 나눈 고정창·프로젝트창에서만 쓰고, 그 밖(칸이 없거나 여닫이·미닫이)에서는 무시한다"
    },
    "transom": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "min": 0,
      "max": 6000,
      "description": "가로대 높이(창 아래에서 가로대 윗면까지, 26단계). 0 이면 없다. 창 아래·위 끝에서 300mm 이상 떨어져야 쓰인다(아니면 없는 것으로 본다). 고정창·프로젝트창만"
    },
    "transom2": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "min": 0,
      "max": 6000,
      "description": "2번째 가로대 높이(창 아래에서). 0 이면 없음. 앞 가로대보다 300mm 이상 위, 창 위 끝보다 300mm 이상 아래일 때만 가로대가 된다(transoms 목록으로 주면 그렇지 않을 때 거절한다)"
    },
    "bay1_2": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "2단(아래에서 2번째 단, 가로대 위) 1번째 칸의 열림 방식. same 이면 operation 을 따른다. 그 단·칸이 없으면 무시한다"
    },
    "bay2_2": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "2단(아래에서 2번째 단, 가로대 위) 2번째 칸의 열림 방식. same 이면 operation 을 따른다. 그 단·칸이 없으면 무시한다"
    },
    "bay3_2": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "2단(아래에서 2번째 단, 가로대 위) 3번째 칸의 열림 방식. same 이면 operation 을 따른다. 그 단·칸이 없으면 무시한다"
    },
    "bay1_3": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "3단(아래에서 3번째 단, 가로대 위) 1번째 칸의 열림 방식. same 이면 operation 을 따른다. 그 단·칸이 없으면 무시한다"
    },
    "bay2_3": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "3단(아래에서 3번째 단, 가로대 위) 2번째 칸의 열림 방식. same 이면 operation 을 따른다. 그 단·칸이 없으면 무시한다"
    },
    "bay3_3": {
      "kind": "type",
      "default": "same",
      "type": "enum",
      "values": [
        "same",
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "3단(아래에서 3번째 단, 가로대 위) 3번째 칸의 열림 방식. same 이면 operation 을 따른다. 그 단·칸이 없으면 무시한다"
    },
    "stool_t": {
      "kind": "type",
      "default": 20,
      "unit": "mm",
      "description": "창대(실내 쪽 하부 판) 두께, 0 이면 없음",
      "min": 0,
      "max": 60
    },
    "stool_proj": {
      "kind": "type",
      "default": 25,
      "unit": "mm",
      "description": "창대가 벽 안쪽 면 밖으로 내민 길이",
      "min": 0,
      "max": 100
    },
    "casing_w": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "description": "문선(실내 쪽 개구부 둘레 띠) 폭, 0 이면 없음",
      "min": 0,
      "max": 150
    },
    "casing_t": {
      "kind": "type",
      "default": 12,
      "unit": "mm",
      "description": "문선 두께(벽 안쪽 면에서 튀어나온 길이)",
      "min": 5,
      "max": 40
    },
    "u_value": {
      "kind": "type",
      "default": 1.6,
      "unit": "none",
      "description": "열관류율 W/m2K",
      "min": 0.5,
      "max": 5.0
    },
    "is_external": {
      "kind": "type",
      "default": true,
      "type": "bool"
    },
    "sill": {
      "kind": "instance",
      "default": 900,
      "unit": "mm",
      "description": "바닥에서 창 하단까지",
      "min": 0,
      "max": 12000
    },
    "inset": {
      "kind": "instance",
      "default": 100,
      "unit": "mm",
      "description": "기준면(호스트 지역 -v 면, 뒤집으면 +v 면)에서 창틀 바깥면까지 거리(리빌 깊이). 0 이면 기준면에 맞춤. 벽이 얇으면 틀이 벽 안에 들어가는 최대값으로 줄어든다",
      "min": 0,
      "max": 600
    },
    "hinge": {
      "kind": "instance",
      "default": "L",
      "type": "enum",
      "values": [
        "L",
        "R"
      ],
      "description": "여닫이일 때 경첩 쪽(L = 지역 -x 쪽)"
    }
  },
  "derived": {
    "z0": "sill",
    "z1": "sill + height",
    "fd": "min(frame_d, host_thickness)",
    "ie": "max(0, min(inset, host_thickness - fd))",
    "fy0": "-host_thickness/2 + ie",
    "fy1": "fy0 + fd",
    "gy": "fy0 + fd/2",
    "sash_w": "frame_w*0.8",
    "sash_d": "fd - 10",
    "gm": "frame_w if operation == 'fixed' else frame_w + sash_w",
    "inner_w": "width - 2*gm",
    "inner_h": "height - 2*gm",
    "leaf_w": "width - 2*frame_w",
    "hinge_x": "(-width/2 + frame_w) if hinge == 'L' else (width/2 - frame_w)",
    "open_sign": "1 if operation == 'casement_in' else -1",
    "arc0": "(0 if hinge == 'L' else 90) if operation == 'casement_in' else (270 if hinge == 'L' else 180)",
    "st_y1": "host_thickness/2 + stool_proj",
    "stool_on": "stool_t > 0 and st_y1 > fy1",
    "glass_ratio": "inner_w*inner_h/(width*height)",
    "sl": "operation == 'sliding'",
    "casement": "operation == 'casement_in' or operation == 'casement_out'",
    "sl_d": "(fd - 10)/2",
    "sl_w": "(width - 2*frame_w + sash_w)/2",
    "opok": "operation == 'fixed' or operation == 'project_out' or operation == 'project_left' or operation == 'project_right'",
    "tz": "z0 + transom",
    "has_tr": "transom >= 300 and transom <= height - 300",
    "tz2": "z0 + transom2",
    "has_tr2": "has_tr and transom2 >= transom + 300 and transom2 <= height - 300",
    "n_tr": "(1 if has_tr else 0) + (1 if has_tr2 else 0)",
    "e1": "bay1 if bay1 != 'same' and (mullions > 0 or n_tr > 0) and opok else operation",
    "e2": "bay2 if bay2 != 'same' and mullions > 0 and opok else operation",
    "e3": "bay3 if bay3 != 'same' and mullions >= 2 and opok else operation",
    "e12": "bay1_2 if bay1_2 != 'same' and n_tr >= 1 and opok else operation",
    "e22": "bay2_2 if bay2_2 != 'same' and n_tr >= 1 and mullions > 0 and opok else operation",
    "e32": "bay3_2 if bay3_2 != 'same' and n_tr >= 1 and mullions >= 2 and opok else operation",
    "e13": "bay1_3 if bay1_3 != 'same' and n_tr >= 2 and opok else operation",
    "e23": "bay2_3 if bay2_3 != 'same' and n_tr >= 2 and mullions > 0 and opok else operation",
    "e33": "bay3_3 if bay3_3 != 'same' and n_tr >= 2 and mullions >= 2 and opok else operation",
    "qr1": "e1 != 'fixed' or (mullions >= 1 and e2 != 'fixed') or (mullions >= 2 and e3 != 'fixed')",
    "qr2": "n_tr >= 1 and (e12 != 'fixed' or (mullions >= 1 and e22 != 'fixed') or (mullions >= 2 and e32 != 'fixed'))",
    "qr3": "n_tr >= 2 and (e13 != 'fixed' or (mullions >= 1 and e23 != 'fixed') or (mullions >= 2 and e33 != 'fixed'))",
    "bay_mixed": "(mullions > 0 or n_tr > 0) and opok and (qr1 or qr2 or qr3)",
    "b1a": "left + frame_w",
    "b1b": "(left + frame_w + (width - 2*frame_w)/(mullions + 1) - frame_w/4) if mullions > 0 else (right - frame_w)",
    "b2a": "left + frame_w + (width - 2*frame_w)/(mullions + 1) + frame_w/4",
    "b2b": "(left + frame_w + 2*(width - 2*frame_w)/(mullions + 1) - frame_w/4) if mullions >= 2 else (right - frame_w)",
    "b3a": "left + frame_w + 2*(width - 2*frame_w)/(mullions + 1) + frame_w/4",
    "b3b": "right - frame_w",
    "p1": "bay_mixed and e1 != 'fixed'",
    "p2": "bay_mixed and mullions >= 1 and e2 != 'fixed'",
    "p3": "bay_mixed and mullions >= 2 and e3 != 'fixed'",
    "p12": "bay_mixed and n_tr >= 1 and e12 != 'fixed'",
    "p22": "bay_mixed and n_tr >= 1 and mullions >= 1 and e22 != 'fixed'",
    "p32": "bay_mixed and n_tr >= 1 and mullions >= 2 and e32 != 'fixed'",
    "p13": "bay_mixed and n_tr >= 2 and e13 != 'fixed'",
    "p23": "bay_mixed and n_tr >= 2 and mullions >= 1 and e23 != 'fixed'",
    "p33": "bay_mixed and n_tr >= 2 and mullions >= 2 and e33 != 'fixed'",
    "g1": "sash_w if p1 else 0",
    "g2": "sash_w if p2 else 0",
    "g3": "sash_w if p3 else 0",
    "r1b": "(tz - frame_w/2) if has_tr else (z1 - frame_w)",
    "r2b": "(tz2 - frame_w/2) if has_tr2 else (z1 - frame_w)"
  },
  "refs": {
    "left": {
      "axis": "x",
      "at": "-width/2"
    },
    "right": {
      "axis": "x",
      "at": "width/2"
    }
  },
  "constraints": [
    {
      "expr": "inner_w >= 100 and inner_h >= 100",
      "message": "유리 개구가 100mm 미만이다(frame_w 를 줄이거나 width/height 를 키우세요)"
    },
    {
      "expr": "glass_t <= fd - 10",
      "message": "유리가 틀 깊이보다 10mm 이상 얇아야 한다(frame_d 를 키우거나 glass_t 를 줄이세요)"
    },
    {
      "expr": "opok or mullions == 0",
      "message": "멀리언은 고정창·프로젝트창(위·옆 경첩)에만 둘 수 있다(여닫이·미닫이는 mullions 를 0 으로)"
    },
    {
      "expr": "operation != 'sliding' or glass_t <= sl_d - 4",
      "message": "미닫이창은 유리가 문짝 두께(틀 깊이의 절반 안팎)보다 4mm 이상 얇아야 한다(frame_d 를 키우거나 glass_t 를 줄이세요)"
    },
    {
      "expr": "operation != 'sliding' or sl_w - 2*sash_w >= 100",
      "message": "미닫이 문짝의 유리 폭이 100mm 미만이다(width 를 키우세요)"
    },
    {
      "expr": "not bay_mixed or (b1b - b1a - 2*sash_w >= 100 and (mullions == 0 or b2b - b2a - 2*sash_w >= 100))",
      "message": "프로젝트 칸의 유리 폭이 100mm 미만이다(width 를 키우거나 멀리언을 줄이세요)"
    },
    {
      "expr": "n_tr == 0 or opok",
      "message": "가로대는 고정창·프로젝트창에만 둘 수 있다(여닫이·미닫이는 transom 을 0 으로)"
    },
    {
      "expr": "n_tr == 0 or (r1b - z0 - frame_w - (2*sash_w if bay_mixed and qr1 else 0) >= 100 and r2b - tz - (2*sash_w if bay_mixed and qr2 else 0) >= 100)",
      "message": "가로대로 나눈 단의 유리 높이가 100mm 미만이다(가로대를 옮기거나 height 를 키우세요)"
