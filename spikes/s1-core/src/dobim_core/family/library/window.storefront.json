{
  "schema": "dobim.family/1",
  "id": "window.storefront",
  "version": 3,
  "name": "복합 창호",
  "description": "벽에 호스팅되는 큰 창호(스토어프런트). 고정창 칸(bay_max 이하 등분 또는 col1~8 폭 목록)과 선택 여닫이문, 가로대(transom~transom4). 한 단(bay_row)의 칸마다 열림 방식(bay1~8: 고정·위 경첩·옆 경첩 프로젝트). 끝(end_l/end_r)을 corner 로 두면 모서리에서 다른 벽의 창호와 이어진다(family.place_corner).",
  "ifc": {
    "class": "IfcWindow",
    "type_class": "IfcWindowType",
    "predefined": "WINDOW",
    "type_attrs": {
      "PartitioningType": "USERDEFINED",
      "UserDefinedPartitioningType": {
        "expr": "'STOREFRONT_DOOR' if door_w > 0 else 'STOREFRONT'"
      },
      "ParameterTakesPrecedence": false
    },
    "attrs": {
      "OverallWidth": {
        "expr": "width"
      },
      "OverallHeight": {
        "expr": "height"
      }
    },
    "panels": [
      {
        "operation": "FIXEDCASEMENT",
        "position": "MIDDLE"
      },
      {
        "operation": "OTHEROPERATION",
        "position": "MIDDLE",
        "when": "door_w > 0"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay1 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay1 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay1 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay1 != 'fixed'"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay2 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay2 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay2 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay2 != 'fixed'"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay3 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay3 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay3 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay3 != 'fixed'"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay4 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay4 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay4 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay4 != 'fixed'"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay5 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay5 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay5 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay5 != 'fixed'"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay6 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay6 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay6 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay6 != 'fixed'"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay7 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay7 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay7 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay7 != 'fixed'"
      },
      {
        "operation": {
          "expr": "'TOPHUNG' if bay8 == 'project_out' else ('SIDEHUNGLEFTHAND' if bay8 == 'project_left' else ('SIDEHUNGRIGHTHAND' if bay8 == 'project_right' else 'FIXEDCASEMENT'))"
        },
        "position": "MIDDLE",
        "when": "bay_row <= n_tr + 1 and bay8 != 'fixed'"
      }
    ]
  },
  "host": {
    "kinds": [
      "wall"
    ],
    "cut": {
      "x": [
        "left",
        "right"
      ],
      "z": [
        "z0",
        "z1"
      ]
    }
  },
  "params": {
    "width": {
      "kind": "type",
      "default": 4000,
      "unit": "mm",
      "description": "창호 전체 폭(틀 바깥)",
      "min": 600,
      "max": 30000
    },
    "height": {
      "kind": "type",
      "default": 3000,
      "unit": "mm",
      "description": "창호 전체 높이(틀 바깥). 하한 400(틀 2개 + 유리 100). 문(door_w > 0)은 높이 2000 이상에서만 둘 수 있다",
      "min": 400,
      "max": 8000
    },
    "frame_w": {
      "kind": "type",
      "default": 50,
      "unit": "mm",
      "description": "틀·멀리언 단면 폭",
      "min": 30,
      "max": 150
    },
    "frame_d": {
      "kind": "type",
      "default": 100,
      "unit": "mm",
      "description": "틀 깊이",
      "min": 50,
      "max": 250
    },
    "glass_t": {
      "kind": "type",
      "default": 24,
      "unit": "mm",
      "description": "유리 두께",
      "min": 6,
      "max": 40
    },
    "bay_max": {
      "kind": "type",
      "default": 1500,
      "unit": "mm",
      "description": "고정창 한 칸의 최대 폭(구간을 이 폭 이하로 똑같이 나눈다)",
      "min": 600,
      "max": 4000
    },
    "transom": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "description": "가로대 높이(창호 아래에서 가로대 윗면까지). 0 이면 없다. 창호 아래·위 끝에서 300mm 이상 떨어져야 쓰인다(아니면 없는 것으로 본다). 문이 있으면 문 위 끝이 가로대 아래다",
      "min": 0,
      "max": 7000
    },
    "transom2": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "description": "2번째 가로대 높이(창호 아래에서). 0 이면 없음. 앞 가로대보다 300mm 이상 위, 창호 위 끝보다 300mm 이상 아래일 때만 가로대가 된다(아니면 없는 것으로 본다). transoms 목록으로 주면 그렇지 않을 때 거절한다",
      "min": 0,
      "max": 7000
    },
    "transom3": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "description": "3번째 가로대 높이(창호 아래에서). 0 이면 없음. 앞 가로대보다 300mm 이상 위, 창호 위 끝보다 300mm 이상 아래일 때만 가로대가 된다(아니면 없는 것으로 본다). transoms 목록으로 주면 그렇지 않을 때 거절한다",
      "min": 0,
      "max": 7000
    },
    "transom4": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "description": "4번째 가로대 높이(창호 아래에서). 0 이면 없음. 앞 가로대보다 300mm 이상 위, 창호 위 끝보다 300mm 이상 아래일 때만 가로대가 된다(아니면 없는 것으로 본다). transoms 목록으로 주면 그렇지 않을 때 거절한다",
      "min": 0,
      "max": 7000
    },
    "door_w": {
      "kind": "type",
      "default": 0,
      "unit": "mm",
      "description": "문 개구 폭(문설주 사이). 0 이면 문이 없다. 창호 안 폭보다 넓으면 문을 두지 않는다(DoBIM_WindowParams.DoorWidth 가 0)",
      "min": 0,
      "max": 3600
    },
    "door_leaves": {
      "kind": "type",
      "default": 1,
      "type": "int",
      "unit": "none",
      "description": "문짝 수(1 = 외여닫이, 2 = 양여닫이)",
      "min": 1,
      "max": 2
    },
    "leaf_t": {
      "kind": "type",
      "default": 50,
      "unit": "mm",
      "description": "문짝 두께",
      "min": 30,
      "max": 80
    },
    "bay1": {
      "kind": "type",
      "default": "fixed",
      "type": "enum",
      "values": [
        "fixed",
        "project_out",
        "project_left",
        "project_right"
      ],
      "description": "bay_row 단의 1번째 칸(왼쪽 구간부터 문 오른쪽 구간까지 이어 센다) 열림 방식. project_out = 위 경첩, project_left/right = 옆 경첩(바깥 -v 쪽에서 볼 때 왼쪽/오른쪽)"
    },
    "bay2": {
      "kind": "type",
      "default": "fixed",
      "type": "enum",
      "values": [
        "fixed",
