  "derived": {
    "z0": "sill",
    "z1": "sill + height",
    "fd": "min(frame_d, host_thickness)",
    "fy0": "-fd/2",
    "fy1": "fd/2",
    "gy": "0",
    "jl": "frame_w if end_l == 'jamb' else 0",
    "jr": "frame_w if end_r == 'jamb' else 0",
    "xa": "left + jl",
    "xe": "right - jr",
    "has_door": "door_w > 0 and door_w <= xe - xa and height >= 2000",
    "dpos": "min(door_pos, xe - xa - door_w) if has_door else 0",
    "dl": "xa + dpos",
    "dr": "xa + dpos + door_w",
    "post_l": "has_door and dpos > 0",
    "post_r": "has_door and dr < xe",
    "seg1_b": "(dl - frame_w if post_l else dl) if has_door else xe",
    "seg2_a": "dr + frame_w",
    "seg1": "seg1_b - xa > 1",
    "seg2": "has_door and xe - seg2_a > 1",
    "s1": "col1",
    "s2": "s1 + col2",
    "s3": "s2 + col3",
    "s4": "s3 + col4",
    "s5": "s4 + col5",
    "s6": "s5 + col6",
    "s7": "s6 + col7",
    "s8": "s7 + col8",
    "ncol": "(1 if col1 > 0 else 0) + (1 if col2 > 0 else 0) + (1 if col3 > 0 else 0) + (1 if col4 > 0 else 0) + (1 if col5 > 0 else 0) + (1 if col6 > 0 else 0) + (1 if col7 > 0 else 0) + (1 if col8 > 0 else 0)",
    "cmin": "frame_w + 100",
    "cwok": "(col1 == 0 or col1 >= cmin) and (col2 == 0 or col2 >= cmin) and (col3 == 0 or col3 >= cmin) and (col4 == 0 or col4 >= cmin) and (col5 == 0 or col5 >= cmin) and (col6 == 0 or col6 >= cmin) and (col7 == 0 or col7 >= cmin) and (col8 == 0 or col8 >= cmin)",
    "ccont": "(col2 == 0 or col1 > 0) and (col3 == 0 or col2 > 0) and (col4 == 0 or col3 > 0) and (col5 == 0 or col4 > 0) and (col6 == 0 or col5 > 0) and (col7 == 0 or col6 > 0) and (col8 == 0 or col7 > 0)",
    "crem": "seg1_b - xa - s8",
    "cols_ok": "seg1 and ncol > 0 and cwok and ccont and crem >= -1 and (crem <= 1 or crem >= cmin)",
    "n_cm": "(ncol - (1 if crem <= 1 else 0)) if cols_ok else 0",
    "n1": "(n_cm + 1) if cols_ok else (max(1, ceil((seg1_b - xa)/bay_max)) if seg1 else 0)",
    "n2": "max(1, ceil((xe - seg2_a)/bay_max)) if seg2 else 0",
    "b1": "(seg1_b - xa)/n1 if seg1 else 0",
    "b2": "(xe - seg2_a)/n2 if seg2 else 0",
    "tz": "z0 + transom",
    "has_tr": "transom >= 300 and transom <= height - 300",
    "tz2": "z0 + transom2",
    "has_tr2": "has_tr and transom2 >= transom + 300 and transom2 <= height - 300",
    "tz3": "z0 + transom3",
    "has_tr3": "has_tr2 and transom3 >= transom2 + 300 and transom3 <= height - 300",
    "tz4": "z0 + transom4",
    "has_tr4": "has_tr3 and transom4 >= transom3 + 300 and transom4 <= height - 300",
    "n_tr": "(1 if has_tr else 0) + (1 if has_tr2 else 0) + (1 if has_tr3 else 0) + (1 if has_tr4 else 0)",
    "glass_top": "(tz - frame_w) if has_tr else (z1 - frame_w)",
    "door_top": "(tz - frame_w) if has_tr else (z1 - frame_w)",
    "leaf_w": "door_w / door_leaves",
    "lg": "min(100, leaf_w/4)",
    "open_sign": "1 if open == 'in' else -1",
    "hinge_x": "dl if swing == 'L' else dr",
    "arc0": "(0 if swing == 'L' else 90) if open == 'in' else (270 if swing == 'L' else 180)",
    "bayon": "bay_row <= n_tr + 1 and (bay_row == 1 or not has_door)",
    "ra": "(z0 + frame_w) if bay_row == 1 else (tz if bay_row == 2 else (tz2 if bay_row == 3 else (tz3 if bay_row == 4 else tz4)))",
    "rb": "glass_top if bay_row == 1 else ((tz2 - frame_w) if bay_row == 2 and has_tr2 else ((tz3 - frame_w) if bay_row == 3 and has_tr3 else ((tz4 - frame_w) if bay_row == 4 and has_tr4 else (z1 - frame_w))))",
    "sw": "frame_w*0.8",
    "sd": "fd - 10",
    "any_op": "bay1 != 'fixed' or bay2 != 'fixed' or bay3 != 'fixed' or bay4 != 'fixed' or bay5 != 'fixed' or bay6 != 'fixed' or bay7 != 'fixed' or bay8 != 'fixed'"
  },
