      {
        "type": "line",
        "when": "seg2",
        "from": [
          "seg2_a",
          "fy0"
        ],
        "to": [
          "xe",
          "fy0"
        ]
      },
      {
        "type": "line",
        "when": "seg2",
        "from": [
          "seg2_a",
          "fy1"
        ],
        "to": [
          "xe",
          "fy1"
        ]
      },
      {
        "type": "line",
        "when": "seg2",
        "from": [
          "seg2_a",
          "gy"
        ],
        "to": [
          "xe",
          "gy"
        ]
      },
      {
        "type": "line",
        "when": "has_door and door_leaves == 1",
        "from": [
          "hinge_x",
          "gy"
        ],
        "to": [
          "hinge_x",
          "gy + open_sign*door_w"
        ]
      },
      {
        "type": "arc",
        "when": "has_door and door_leaves == 1",
        "center": [
          "hinge_x",
          "gy"
        ],
        "radius": "door_w",
        "start": "arc0",
        "end": "arc0 + 90"
      },
      {
        "type": "line",
        "when": "has_door and door_leaves == 2",
        "from": [
          "dl",
          "gy"
        ],
        "to": [
          "dl",
          "gy + open_sign*leaf_w"
        ]
      },
      {
        "type": "line",
        "when": "has_door and door_leaves == 2",
        "from": [
          "dr",
          "gy"
        ],
        "to": [
          "dr",
          "gy + open_sign*leaf_w"
        ]
      },
      {
        "type": "arc",
        "when": "has_door and door_leaves == 2",
        "center": [
          "dl",
          "gy"
        ],
        "radius": "leaf_w",
        "start": "0 if open == 'in' else 270",
        "end": "90 if open == 'in' else 360"
      },
      {
        "type": "arc",
        "when": "has_door and door_leaves == 2",
        "center": [
          "dr",
          "gy"
        ],
        "radius": "leaf_w",
        "start": "90 if open == 'in' else 180",
        "end": "180 if open == 'in' else 270"
      }
    ],
    "1:200": [
      {
        "type": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "fy0",
          "fy1"
        ],
        "style": "cut"
      }
    ]
  },
  "psets": {
    "Pset_WindowCommon": {
      "on": "type",
      "props": {
        "IsExternal": {
          "expr": "is_external"
        },
        "ThermalTransmittance": {
          "expr": "u_value"
        }
      }
    },
    "DoBIM_StorefrontParams": {
      "on": "type",
      "props": {
        "BayMax": {
          "expr": "bay_max"
        },
        "Transom": {
          "expr": "transom if has_tr else 0"
        },
        "DoorLeaves": {
          "expr": "door_leaves"
        },
        "TransomCount": {
          "expr": "n_tr"
        }
      }
    },
    "DoBIM_WindowParams": {
      "on": "instance",
      "props": {
        "SillHeight": {
          "expr": "sill"
        },
        "DoorWidth": {
          "expr": "door_w if has_door else 0"
        },
        "DoorPosition": {
          "expr": "dpos"
        },
        "Swing": {
          "expr": "swing"
        },
        "DoorOpen": {
          "expr": "open"
        },
        "EndLeft": {
          "expr": "end_l"
        },
        "EndRight": {
          "expr": "end_r"
        },
        "Bays": {
          "expr": "n1 + n2"
        },
        "Columns": {
          "expr": "n1 if cols_ok else 0"
        }
      }
    }
  }
}
