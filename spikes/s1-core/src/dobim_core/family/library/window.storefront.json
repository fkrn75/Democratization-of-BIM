  "constraints": [
    {
      "expr": "not has_door or dpos == 0 or dpos >= frame_w + 100",
      "message": "문 왼쪽 고정창 칸이 100mm 미만이다(door_pos 를 0 또는 frame_w + 100 이상으로)"
