{
  "schema": "dobim.family/1",
  "id": "window.hung",
  "version": 1,
  "name": "오르내리창",
  "description": "벽에 호스팅되는 오르내리창(내리닫이창). 창틀(압출 - 공극)과 위·아래 창짝(울거미 + 유리) 둘이 앞뒤로 엇갈려 50mm 겹친다. 평면에 창짝 두 선.",
  "ifc": {
    "class": "IfcWindow",
    "type_class": "IfcWindowType",
    "predefined": "WINDOW",
    "type_attrs": {
      "PartitioningType": "DOUBLE_PANEL_HORIZONTAL",
      "ParameterTakesPrecedence": false
    },
    "attrs": {
      "OverallWidth": {
        "expr": "width"
      },
      "OverallHeight": {
        "expr": "height"
      }
    },
    "panels": [
      {
        "operation": "SLIDINGVERTICAL",
        "position": "BOTTOM"
      },
      {
        "operation": "SLIDINGVERTICAL",
        "position": "TOP"
      }
    ]
  },
  "host": {
    "kinds": [
      "wall"
    ],
    "cut": {
      "x": [
        "left",
        "right"
      ],
      "z": [
        "z0",
        "z1"
      ]
    }
  },
  "params": {
    "width": {
      "kind": "type",
      "default": 900,
      "unit": "mm",
      "min": 450,
      "max": 1800
    },
    "height": {
      "kind": "type",
      "default": 1400,
      "unit": "mm",
      "min": 800,
      "max": 2400
    },
    "frame_w": {
      "kind": "type",
      "default": 60,
      "unit": "mm",
      "description": "창틀 단면 폭",
      "min": 30,
      "max": 80
    },
    "sash_w": {
      "kind": "type",
      "default": 50,
      "unit": "mm",
      "description": "창짝 울거미 폭",
      "min": 30,
      "max": 70
    },
    "glass_t": {
      "kind": "type",
      "default": 24,
      "unit": "mm",
      "description": "유리 두께",
      "min": 6,
      "max": 40
    },
    "u_value": {
      "kind": "type",
      "default": 1.6,
      "unit": "none",
      "description": "열관류율 W/m2K",
      "min": 0.5,
      "max": 5.0
    },
    "is_external": {
      "kind": "type",
      "default": true,
      "type": "bool"
    },
    "sill": {
      "kind": "instance",
      "default": 900,
      "unit": "mm",
      "description": "바닥에서 창 하단까지",
      "min": 0,
      "max": 1500
    }
  },
  "derived": {
    "z0": "sill",
    "z1": "sill + height",
    "frame_d": "min(host_thickness, 150)",
    "ix0": "left + frame_w",
    "ix1": "right - frame_w",
    "iz0": "z0 + frame_w",
    "iz1": "z1 - frame_w",
    "iw": "width - 2*frame_w - 4 - 2*sash_w",
    "sh": "(iz1 - iz0)/2 + 25",
    "hh": "(height - 2*frame_w)/2 + 23 - 2*sash_w",
    "glass_ratio": "2*iw*hh/(width*height)"
  },
  "refs": {
    "left": {
      "axis": "x",
      "at": "-width/2"
    },
    "right": {
      "axis": "x",
      "at": "width/2"
    }
  },
  "constraints": [
    {
      "expr": "iw >= 150 and hh >= 150",
      "message": "창짝 유리 자리가 150mm 미만이다"
    },
    {
      "expr": "2*(glass_t + 10) + 10 <= frame_d",
      "message": "창틀 깊이가 창짝 두 겹보다 얕다"
    }
  ],
  "solids": [
    {
      "id": "frame",
      "op": "extrude",
      "plane": "xz",
      "profile": {
        "shape": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "z0",
          "z1"
        ]
      },
      "range": [
        "-frame_d/2",
        "frame_d/2"
      ]
    },
    {
      "id": "frame_hole",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "frame"
      ],
      "profile": {
        "shape": "rect",
        "u": [
          "ix0",
          "ix1"
        ],
        "v": [
          "iz0",
          "iz1"
        ]
      },
      "range": [
        "-frame_d",
        "frame_d"
      ]
    },
    {
      "id": "lower",
      "op": "extrude",
      "plane": "xz",
      "profile": {
        "shape": "rect",
        "u": [
          "ix0 + 2",
          "ix1 - 2"
        ],
        "v": [
          "iz0 + 2",
          "iz0 + sh"
        ]
      },
      "range": [
        2,
        "glass_t + 12"
      ]
    },
    {
      "id": "lower_hole",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "lower"
      ],
      "profile": {
        "shape": "rect",
        "u": [
          "ix0 + 2 + sash_w",
          "ix1 - 2 - sash_w"
        ],
        "v": [
          "iz0 + 2 + sash_w",
          "iz0 + sh - sash_w"
        ]
      },
      "range": [
        "-frame_d",
        "frame_d"
      ]
    },
    {
      "id": "lower_glass",
      "op": "extrude",
      "plane": "xz",
      "profile": {
        "shape": "rect",
        "u": [
          "ix0 + 2 + sash_w",
          "ix1 - 2 - sash_w"
        ],
        "v": [
          "iz0 + 2 + sash_w",
          "iz0 + sh - sash_w"
        ]
      },
      "range": [
        "(2 + glass_t + 12)/2 - glass_t/2",
        "(2 + glass_t + 12)/2 + glass_t/2"
      ]
    },
    {
      "id": "upper",
      "op": "extrude",
      "plane": "xz",
      "profile": {
        "shape": "rect",
        "u": [
          "ix0 + 2",
          "ix1 - 2"
        ],
        "v": [
          "iz1 - sh",
          "iz1 - 2"
        ]
      },
      "range": [
        "-glass_t - 12",
        -2
      ]
    },
    {
      "id": "upper_hole",
      "op": "extrude",
      "plane": "xz",
      "role": "void",
      "cuts": [
        "upper"
      ],
      "profile": {
        "shape": "rect",
        "u": [
          "ix0 + 2 + sash_w",
          "ix1 - 2 - sash_w"
        ],
        "v": [
          "iz1 - sh + sash_w",
          "iz1 - 2 - sash_w"
        ]
      },
      "range": [
        "-frame_d",
        "frame_d"
      ]
    },
    {
      "id": "upper_glass",
      "op": "extrude",
      "plane": "xz",
      "profile": {
        "shape": "rect",
        "u": [
          "ix0 + 2 + sash_w",
          "ix1 - 2 - sash_w"
        ],
        "v": [
          "iz1 - sh + sash_w",
          "iz1 - 2 - sash_w"
        ]
      },
      "range": [
        "(-glass_t - 12 + -2)/2 - glass_t/2",
        "(-glass_t - 12 + -2)/2 + glass_t/2"
      ]
    }
  ],
  "plan_symbol": {
    "default": [
      {
        "type": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "-host_thickness/2",
          "host_thickness/2"
        ],
        "style": "cut"
      },
      {
        "type": "line",
        "from": [
          "ix0",
          "-glass_t/2 - 7"
        ],
        "to": [
          "ix1",
          "-glass_t/2 - 7"
        ],
        "style": "projection"
      },
      {
        "type": "line",
        "from": [
          "ix0",
          "glass_t/2 + 7"
        ],
        "to": [
          "ix1",
          "glass_t/2 + 7"
        ],
        "style": "projection"
      }
    ],
    "1:200": [
      {
        "type": "rect",
        "u": [
          "left",
          "right"
        ],
        "v": [
          "-host_thickness/2",
          "host_thickness/2"
        ],
        "style": "cut"
      }
    ]
  },
  "psets": {
    "Pset_WindowCommon": {
      "on": "type",
      "props": {
        "IsExternal": {
          "expr": "is_external"
        },
        "ThermalTransmittance": {
          "expr": "u_value"
        },
        "GlazingAreaFraction": {
          "expr": "round(glass_ratio, 3)"
        }
      }
    },
    "DoBIM_WindowParams": {
      "on": "instance",
      "props": {
        "SillHeight": {
          "expr": "sill"
        }
      }
    }
  }
}
