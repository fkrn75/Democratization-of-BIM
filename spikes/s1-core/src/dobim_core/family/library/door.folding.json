{
  "schema": "dobim.family/1",
  "id": "door.folding",
  "version": 1,
  "name": "접이문",
  "description": "벽에 호스팅되는 접이문. 문틀(스윕)과 같은 폭 문짝 panels 장(반복 압출), fold 쪽으로 접힌다. 평면에 45도로 반쯤 접힌 지그재그.",
  "ifc": {
    "class": "IfcDoor",
    "type_class": "IfcDoorType",
    "predefined": "DOOR",
    "type_attrs": {
      "OperationType": "NOTDEFINED",
      "ParameterTakesPrecedence": false
    },
    "attrs": {
      "OverallWidth": {
        "expr": "width"
      },
      "OverallHeight": {
        "expr": "height"
      },
      "OperationType": {
        "expr": "'FOLDING_TO_LEFT' if fold == 'L' else 'FOLDING_TO_RIGHT'"
      }
    }
  },
  "host": {
    "kinds": [
      "wall"
    ],
    "cut": {
      "x": [
        "left",
        "right"
      ],
      "z": [
        0,
        "height"
      ]
    }
  },
  "params": {
    "width": {
      "kind": "type",
      "default": 1800,
      "unit": "mm",
      "description": "개구부 폭(문틀 바깥)",
      "min": 1200,
      "max": 3600
    },
    "height": {
      "kind": "type",
      "default": 2100,
      "unit": "mm",
      "description": "개구부 높이",
      "min": 1800,
      "max": 3000
    },
    "frame_w": {
      "kind": "type",
      "default": 50,
      "unit": "mm",
      "description": "문틀 단면 폭",
      "min": 30,
      "max": 100
    },
    "leaf_t": {
      "kind": "type",
      "default": 30,
      "unit": "mm",
      "description": "문짝 두께",
      "min": 20,
      "max": 50
    },
    "panels": {
      "kind": "type",
      "default": 4,
      "type": "int",
      "unit": "none",
      "description": "문짝 장수",
      "min": 2,
      "max": 6
    },
    "is_external": {
      "kind": "type",
      "default": false,
      "type": "bool",
      "description": "외부 문 여부"
    },
    "fold": {
      "kind": "instance",
      "default": "L",
      "type": "enum",
      "values": [
        "L",
        "R"
      ],
      "description": "접혀 모이는 쪽(L=왼쪽)"
    }
  },
  "derived": {
    "fx0": "-width/2 + frame_w/2",
    "fx1": "width/2 - frame_w/2",
    "fz1": "height - frame_w/2",
    "inner": "width - 2*frame_w",
    "pw": "inner/panels",
    "leaf_h": "height - frame_w",
    "fs": "1 if fold == 'L' else -1",
    "fold_x": "(-width/2 + frame_w) if fold == 'L' else (width/2 - frame_w)"
  },
  "refs": {
    "left": {
      "axis": "x",
      "at": "-width/2"
    },
    "right": {
      "axis": "x",
      "at": "width/2"
    }
  },
  "constraints": [
    {
      "expr": "pw >= 150",
      "message": "문짝 한 장의 폭이 150mm 미만이다(panels 를 줄이거나 width 를 키우세요)"
    },
    {
      "expr": "host_thickness >= leaf_t + 20",
      "message": "벽이 문짝 두께보다 20mm 이상 두꺼워야 한다"
    }
  ],
  "solids": [
    {
      "id": "frame",
      "op": "sweep",
      "normal": "y",
      "closed": false,
      "path": [
        [
          "fx0",
          0,
          0
        ],
        [
          "fx0",
          0,
          "fz1"
        ],
        [
          "fx1",
          0,
          "fz1"
        ],
        [
          "fx1",
          0,
          0
        ]
      ],
      "profile": {
        "shape": "rect",
        "w": "frame_w",
        "h": "host_thickness"
      }
    },
    {
      "id": "panel",
      "op": "extrude",
      "plane": "xz",
      "repeat": {
        "var": "i",
        "count": "panels"
      },
      "profile": {
        "shape": "rect",
        "u": [
          "-width/2 + frame_w + i*pw + 2",
          "-width/2 + frame_w + (i + 1)*pw - 2"
        ],
        "v": [
          0,
          "leaf_h"
        ]
      },
      "range": [
        "-leaf_t/2",
        "leaf_t/2"
      ]
    }
  ],
  "plan_symbol": {
    "default": [
      {
        "type": "rect",
        "u": [
          "left",
          "left + frame_w"
        ],
        "v": [
          "-host_thickness/2",
          "host_thickness/2"
        ],
        "style": "cut"
      },
      {
        "type": "rect",
        "u": [
          "right - frame_w",
          "right"
        ],
        "v": [
          "-host_thickness/2",
          "host_thickness/2"
        ],
        "style": "cut"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ]
        ],
        "closed": false,
        "when": "panels == 2",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ]
        ],
        "closed": false,
        "when": "panels == 3",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*4*pw*0.7071",
            "0"
          ]
        ],
        "closed": false,
        "when": "panels == 4",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*4*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*5*pw*0.7071",
            "pw*0.7071"
          ]
        ],
        "closed": false,
        "when": "panels == 5",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*4*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*5*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*6*pw*0.7071",
            "0"
          ]
        ],
        "closed": false,
        "when": "panels == 6",
        "style": "projection"
      }
    ],
    "1:200": [
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ]
        ],
        "closed": false,
        "when": "panels == 2",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ]
        ],
        "closed": false,
        "when": "panels == 3",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*4*pw*0.7071",
            "0"
          ]
        ],
        "closed": false,
        "when": "panels == 4",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*4*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*5*pw*0.7071",
            "pw*0.7071"
          ]
        ],
        "closed": false,
        "when": "panels == 5",
        "style": "projection"
      },
      {
        "type": "polyline",
        "points": [
          [
            "fold_x + fs*0*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*1*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*2*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*3*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*4*pw*0.7071",
            "0"
          ],
          [
            "fold_x + fs*5*pw*0.7071",
            "pw*0.7071"
          ],
          [
            "fold_x + fs*6*pw*0.7071",
            "0"
          ]
        ],
        "closed": false,
        "when": "panels == 6",
        "style": "projection"
      }
    ]
  },
  "psets": {
    "Pset_DoorCommon": {
      "on": "type",
      "props": {
        "IsExternal": {
          "expr": "is_external"
        },
        "HandicapAccessible": {
          "expr": "inner >= 800"
        }
      }
    },
    "DoBIM_DoorParams": {
      "on": "instance",
      "props": {
        "Fold": {
          "expr": "fold"
        }
      }
    }
  }
}
