{
  "schema": "dobim.family/1",
  "id": "cabinet.base",
  "version": 1,
  "name": "주방 하부장",
  "description": "주방 하부장(IfcFurniture USERDEFINED). 몸통·상판(앞으로 내민다)·걸레받이 홈·문짝 선.",
  "ifc": {
    "class": "IfcFurniture",
    "type_class": "IfcFurnitureType",
    "predefined": "USERDEFINED",
    "type_attrs": {
      "ElementType": "KitchenBaseCabinet"
    },
    "attrs": {
      "ObjectType": "KitchenBaseCabinet"
    }
  },
  "params": {
    "top_t": {
      "kind": "type",
      "default": 30,
      "unit": "mm",
      "description": "상판 두께",
      "min": 12,
      "max": 50
    },
    "plinth_h": {
      "kind": "type",
      "default": 100,
      "unit": "mm",
      "description": "걸레받이 높이(0 이면 없음)",
      "min": 0,
      "max": 200
    },
    "overhang": {
      "kind": "type",
      "default": 20,
      "unit": "mm",
      "description": "상판을 앞으로 내미는 길이",
      "min": 0,
      "max": 50
    },
    "width": {
      "kind": "instance",
      "default": 2400,
      "unit": "mm",
      "min": 300,
      "max": 6000
    },
    "depth": {
      "kind": "instance",
      "default": 600,
      "unit": "mm",
      "min": 450,
      "max": 750
    },
    "height": {
      "kind": "instance",
      "default": 850,
      "unit": "mm",
      "description": "상판 윗면 높이",
      "min": 750,
      "max": 950
    },
    "doors": {
      "kind": "instance",
      "default": 4,
      "type": "int",
      "unit": "none",
      "description": "희망 문짝 수(폭에 맞게 door_n 으로 보정된다)",
      "min": 1,
      "max": 12
    }
  },
  "derived": {
    "door_n": "clamp(doors, ceil(width/900), floor(width/250))",
    "door_w": "width/door_n"
  },
  "solids": [
    {
      "id": "body",
      "op": "extrude",
      "plane": "xy",
      "profile": {
        "shape": "rect",
        "u": [
          "-width/2",
          "width/2"
        ],
        "v": [
          "-depth/2",
          "depth/2 - overhang"
        ]
      },
      "range": [
        "plinth_h",
        "height - top_t"
      ]
    },
    {
      "id": "plinth",
      "op": "extrude",
      "plane": "xy",
      "when": "plinth_h > 0",
      "profile": {
        "shape": "rect",
        "u": [
          "-width/2",
          "width/2"
        ],
        "v": [
          "-depth/2",
          "depth/2 - overhang - 60"
        ]
      },
      "range": [
        0,
        "plinth_h"
      ]
    },
    {
      "id": "top",
      "op": "extrude",
      "plane": "xy",
      "profile": {
        "shape": "rect",
        "u": [
          "-width/2",
          "width/2"
        ],
        "v": [
          "-depth/2",
          "depth/2"
        ]
      },
      "range": [
        "height - top_t",
        "height"
      ]
    },
    {
      "id": "door",
      "op": "extrude",
      "plane": "xz",
      "repeat": {
        "var": "k",
        "count": "door_n"
      },
      "profile": {
        "shape": "rect",
        "u": [
          "-width/2 + k*door_w + 2",
          "-width/2 + (k + 1)*door_w - 2"
        ],
        "v": [
          "plinth_h + 2",
          "height - top_t - 2"
        ]
      },
      "range": [
        "depth/2 - overhang",
        "depth/2 - overhang + 1"
      ]
    }
  ],
  "plan_symbol": {
    "default": [
      {
        "type": "rect",
        "u": [
          "-width/2",
          "width/2"
        ],
        "v": [
          "-depth/2",
          "depth/2"
        ],
        "style": "projection"
      },
      {
        "type": "line",
        "from": [
          "-width/2",
          "depth/2 - overhang"
        ],
        "to": [
          "width/2",
          "depth/2 - overhang"
        ],
        "style": "hidden"
      }
    ],
    "1:200": [
      {
        "type": "rect",
        "u": [
          "-width/2",
          "width/2"
        ],
        "v": [
          "-depth/2",
          "depth/2"
        ],
        "style": "projection"
      }
    ]
  },
  "psets": {
    "Pset_FurnitureTypeCommon": {
      "on": "type",
      "props": {
        "IsBuiltIn": true
      }
    }
  }
}
